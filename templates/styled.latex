\documentclass[11pt]{article}
\usepackage[a4paper,margin=$margin$mm]{geometry}
\usepackage{amsmath,amssymb}
\usepackage{booktabs}
\usepackage{array}
\usepackage{longtable}
\usepackage{xcolor}
\usepackage{enumitem}
\usepackage[T1]{fontenc}
\usepackage{mathpazo}
\usepackage{tcolorbox}
\usepackage{fancyvrb}
\usepackage{fvextra}
\fvset{breaklines=true, breakanywhere=true, fontsize=\footnotesize}
\RecustomVerbatimEnvironment{verbatim}{Verbatim}{breaklines=true, breakanywhere=true, fontsize=\footnotesize}
\providecommand{\DefineVerbatimEnvironment}{}
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{breaklines=true, breakanywhere=true, fontsize=\footnotesize, commandchars=\\\{\}}
\usepackage[breaklinks=true,colorlinks=true,linkcolor=blue,urlcolor=blue]{hyperref}
\tcbuselibrary{skins,breakable}
\usepackage{calc}
\usepackage{graphicx}
\usepackage{caption}

% Fix for pandoc longtable \LTcaptype{none} counter bug
\newcounter{none}

% Pandoc compatibility macros
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% ---- Colors matching the reference PDF style ----
\definecolor{hdred}{RGB}{178,24,24}
\definecolor{hdyellow}{RGB}{181,124,10}
\definecolor{hdgreen}{RGB}{30,110,60}
\definecolor{boxbg}{RGB}{250,246,232}
\definecolor{boxline}{RGB}{181,124,10}
\definecolor{ansbg}{RGB}{237,246,239}
\definecolor{ansline}{RGB}{30,120,60}

\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}

% ---- Callout box environment, triggered by a fenced div .callout in the markdown ----
\newtcolorbox{calloutbox}{
  colback=boxbg, colframe=boxline, boxrule=0.6pt,
  arc=1.5pt, left=6pt, right=6pt, top=4pt, bottom=4pt,
  breakable
}
\newtcolorbox{answerbox}{
  colback=ansbg, colframe=ansline, boxrule=0.6pt,
  arc=1.5pt, left=8pt, right=8pt, top=5pt, bottom=5pt,
  breakable
}

% Heading color cycling: h1 red, h2 amber, h3 green — matches the unit-banner style
\usepackage{titlesec}
\titleformat{\section}{\Large\bfseries\color{hdred}}{}{0pt}{}
\titleformat{\subsection}{\large\bfseries\color{hdyellow}}{}{0pt}{}
\titleformat{\subsubsection}{\normalsize\bfseries\color{hdgreen}}{}{0pt}{}

\title{$if(title)$$title$$endif$}
\author{$if(author)$$author$$endif$}
\date{$if(date)$$date$$endif$}

\begin{document}
$if(title)$
\maketitle
$endif$

$body$

\end{document}
