\documentclass[11pt]{article}
\usepackage[a4paper,margin=$if(margin)$$margin$$else$0.5in$endif$]{geometry}
\usepackage{amsmath,amssymb}
\usepackage{booktabs}
\usepackage{array}
\usepackage{longtable}
\usepackage{xcolor}
\usepackage{enumitem}
\usepackage[T1]{fontenc}
\usepackage{mathpazo}
\usepackage{tcolorbox}
\usepackage{fancyvrb}
\usepackage{fvextra}
\fvset{breaklines=true, breakanywhere=true, fontsize=\footnotesize}
\RecustomVerbatimEnvironment{verbatim}{Verbatim}{breaklines=true, breakanywhere=true, fontsize=\footnotesize}
\providecommand{\DefineVerbatimEnvironment}{}
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{breaklines=true, breakanywhere=true, fontsize=\footnotesize, commandchars=\\\{\}}
\usepackage[hidelinks]{hyperref}
\tcbuselibrary{skins,breakable}
\usepackage{calc}
\usepackage{graphicx}
\usepackage{caption}

% Fix for pandoc longtable \LTcaptype{none} counter bug
\newcounter{none}

% Pandoc compatibility macros
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% ---- Formal Black & White / Grayscale Palette ----
\definecolor{boxbg}{gray}{0.97}
\definecolor{boxline}{gray}{0.25}
\definecolor{ansbg}{gray}{0.94}
\definecolor{ansline}{gray}{0.15}

\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}

% ---- Formal Callout box environment (plain monochrome) ----
\newtcolorbox{calloutbox}{
  colback=boxbg, colframe=boxline, boxrule=0.5pt,
  arc=1pt, left=6pt, right=6pt, top=4pt, bottom=4pt,
  breakable
}
\newtcolorbox{answerbox}{
  colback=ansbg, colframe=ansline, boxrule=0.5pt,
  arc=1pt, left=8pt, right=8pt, top=5pt, bottom=5pt,
  breakable
}

% Formal Black Headings
\usepackage{titlesec}
\titleformat{\section}{\Large\bfseries\color{black}}{}{0pt}{}
\titleformat{\subsection}{\large\bfseries\color{black}}{}{0pt}{}
\titleformat{\subsubsection}{\normalsize\bfseries\color{black}}{}{0pt}{}

\title{$if(title)$$title$$endif$}
\author{$if(author)$$author$$endif$}
\date{$if(date)$$date$$endif$}

\begin{document}
$if(title)$
\maketitle
$endif$

$body$

\end{document}
